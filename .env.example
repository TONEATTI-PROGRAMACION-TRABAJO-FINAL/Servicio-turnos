# Copy this file to .env and replace the fictitious values with the ones sent by the cátedra.
# Never commit the real .env.
CATEDRA_API_BASE_URL=https://catedra.example.com
CATEDRA_JWT=jwt-tecnico-ficticio
# Optional, ISO-8601 durations. Default to PT2S and PT5S.
CATEDRA_CONNECT_TIMEOUT=PT2S
CATEDRA_READ_TIMEOUT=PT5S
CATEDRA_KAFKA_BOOTSTRAP_SERVERS=kafka.catedra.example.com:9092
CATEDRA_KAFKA_CONSUMER_GROUP_ID=alumnos-mi-proyecto
CATEDRA_KAFKA_APPOINTMENT_ACTIONS_TOPIC=alumnos.turnos.acciones.mi-proyecto
CATEDRA_KAFKA_APPOINTMENT_PHONE_TOPIC=catedra.turnos.telefono.mi-proyecto
# Optional. Default to PLAINTEXT, earliest, PT2M (ISO-8601) and true.
CATEDRA_KAFKA_SECURITY_PROTOCOL=PLAINTEXT
CATEDRA_KAFKA_AUTO_OFFSET_RESET=earliest
CATEDRA_KAFKA_RETRY_MAX_ELAPSED_TIME=PT2M
CATEDRA_KAFKA_LISTENER_ENABLED=true
# Servicio-catalogo running locally.
CATALOGO_BASE_URL=http://localhost:8081
# Optional, ISO-8601 durations. Default to PT2S and PT3S.
CATALOGO_CONNECT_TIMEOUT=PT2S
CATALOGO_READ_TIMEOUT=PT3S
# Optional. Time zone of the place of attention. Defaults to America/Argentina/Buenos_Aires.
TURNOS_TIME_ZONE=America/Argentina/Buenos_Aires
# JWT for the end users of the app: at least 32 bytes (for example, openssl rand -base64 48).
USER_JWT_SECRET=ficticio-reemplazar-por-un-secreto-de-al-menos-32-bytes
# Optional, ISO-8601 duration. Defaults to PT24H.
USER_JWT_EXPIRATION=PT24H
